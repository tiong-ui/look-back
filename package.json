{
  "name": "look-back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "回望 Look Back — a Taiwan-centred map of history",
  "license": "MIT",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "predev": "npm run data",
